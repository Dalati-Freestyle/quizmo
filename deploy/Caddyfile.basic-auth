# Optional: private deployment behind Basic Auth with QR access links.
#
# Everyone without the access cookie gets the Basic Auth prompt, exactly as
# with a plain `basic_auth` block. Invitation and TV links created by Quizmo
# carry `?quizmo_key=<QUIZMO_ACCESS_KEY>`; such a request receives a 12 hour
# cookie, so guests who scan a QR code never type the password and the
# WebSocket connection (which browsers do not always authenticate with Basic
# Auth) works on every mobile and desktop browser.
#
# Required environment of the caddy service:
#   QUIZMO_DOMAIN, QUIZMO_ACCESS_KEY (same value as for the quizmo service,
#   32-128 characters A-Z a-z 0-9 _ -), QUIZMO_BASIC_AUTH_USER and
#   QUIZMO_BASIC_AUTH_HASH (from `caddy hash-password`).
# Use it instead of `Caddyfile` by mounting it to /etc/caddy/Caddyfile.
{$QUIZMO_DOMAIN} {
    encode zstd gzip

    @accessLink query quizmo_key={$QUIZMO_ACCESS_KEY}
    header @accessLink Set-Cookie "quizmo_access={$QUIZMO_ACCESS_KEY}; Path=/; Max-Age=43200; Secure; HttpOnly; SameSite=Lax"

    @locked {
        not query quizmo_key={$QUIZMO_ACCESS_KEY}
        not header Cookie *quizmo_access={$QUIZMO_ACCESS_KEY}*
    }
    basic_auth @locked {
        {$QUIZMO_BASIC_AUTH_USER} {$QUIZMO_BASIC_AUTH_HASH}
    }

    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://www.gstatic.com https://www.youtube.com https://s.ytimg.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https: wss:; media-src 'self' data: blob: https:; frame-src https://www.youtube.com https://www.youtube-nocookie.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        -Server
    }
    request_body {
        max_size 64KB
    }
    reverse_proxy quizmo:8080
}
