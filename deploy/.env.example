QUIZMO_DOMAIN=quiz.example.com
# For prebuilt releases, uncomment and replace with the version from your release:
# QUIZMO_IMAGE=ghcr.io/owner/repository-server:1.1.0
# Or after docker load: QUIZMO_IMAGE=quizmo-server:1.1.0
# Optional private mode (see README, "Basic Auth with QR access links"):
# QUIZMO_ACCESS_KEY=<32-128 random characters, e.g. openssl rand -base64 48 | tr '+/' '-_' | tr -d '='>
# QUIZMO_BASIC_AUTH_USER=quizmaster
# QUIZMO_BASIC_AUTH_HASH=<caddy hash-password output, every $ written as $$>
